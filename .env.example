# Polypilot configuration. Copy to .env and fill in as needed.
# NEVER commit a real .env — it is gitignored. Keep your private key secret.

# --- Mode & bankroll ---
POLYPILOT_MODE=paper                 # paper (simulated fills) | live (REAL money)
POLYPILOT_STARTING_BALANCE_USD=200   # paper bankroll; live is anchored to real USDC
POLYPILOT_DATA_DIR=                  # optional; defaults to ~/.local/share/polypilot

# --- Kill-switch (the ONLY hard guardrail) — halts trading at these cumulative losses ---
POLYPILOT_KILL_SWITCH_DAILY_USD=50
POLYPILOT_KILL_SWITCH_TOTAL_USD=100

# --- Live trading (only needed for POLYPILOT_MODE=live) ---
POLYMARKET_PRIVATE_KEY=              # your Polygon wallet private key — KEEP SECRET
POLYMARKET_PROXY_ADDRESS=            # Polymarket proxy/funder address, if used
POLYMARKET_SIGNATURE_TYPE=0          # 0 (EOA) | 1 (email/magic) | 2 (proxy)
POLYMARKET_HOST=https://clob.polymarket.com
POLYPILOT_HTTP_PROXY=                # optional; routes the live CLOB trading client through this proxy

# --- Notifications (optional; best-effort, no-op when unset) ---
POLYPILOT_WEBHOOK_URL=               # generic HTTP POST of {event,message}
POLYPILOT_TELEGRAM_BOT_TOKEN=        # Telegram bot token (needs chat id too)
POLYPILOT_TELEGRAM_CHAT_ID=

# --- Optional research data ---
FRED_API_KEY=                        # official economic data (inflation/GDP/rates)
NEWSAPI_KEY=                         # broader news coverage (RSS works without it)
POLYPILOT_PANDASCORE_KEY=            # esports match data (get_esports); free tier at pandascore.co
